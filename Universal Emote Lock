-- [[ CONFIGURAÇÃO DA GUI - FINAL ]] --
local ScreenGui = Instance.new("ScreenGui")
local FreezeButton = Instance.new("ImageButton")

-- Seus IDs
local ID_MOVENDO = "rbxassetid://110202800914637"
local ID_PARALISADO = "rbxassetid://108879366953239"

ScreenGui.Name = "FreezeEmote_Final_V6"
ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

-- Botão apenas imagem
FreezeButton.Name = "FreezeButton"
FreezeButton.Parent = ScreenGui
FreezeButton.BackgroundTransparency = 1
FreezeButton.BorderSizePixel = 0
FreezeButton.Position = UDim2.new(0.85, 0, 0.70, 0)
FreezeButton.Size = UDim2.new(0, 65, 0, 65)
FreezeButton.Image = ID_MOVENDO
FreezeButton.ScaleType = Enum.ScaleType.Fit

-- [[ SISTEMA DE ARRASTAR COM TRAVA ]] --
local isPaused = false -- Variável de controle movida para cima para ser acessível
local dragging, dragInput, dragStart, startPos

local function update(input)
    -- AJUSTE: Só permite mover se NÃO estiver pausado
    if isPaused then return end
    
    local delta = input.Position - dragStart
    FreezeButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

FreezeButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        -- AJUSTE: Só inicia o arraste se não estiver pausado
        if not isPaused then
            dragging = true
            dragStart = input.Position
            startPos = FreezeButton.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
        update(input)
    end
end)

-- [[ LÓGICA DE CLIQUE DUPLO E CONGELAMENTO ]] --
local lastClick = 0

FreezeButton.MouseButton1Click:Connect(function()
    local currentTime = tick()
    
    -- Clique duplo para fechar
    if currentTime - lastClick < 0.3 then
        ScreenGui:Destroy()
        return
    end
    lastClick = currentTime

    local character = game.Players.LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChild("Humanoid")
    local animateScript = character:FindFirstChild("Animate")
    if not humanoid then return end
    
    isPaused = not isPaused
    
    if isPaused then
        -- MODO: ESTÁTUA (Ícone fixo e animação travada)
        FreezeButton.Image = ID_PARALISADO
        dragging = false -- Garante que pare de arrastar se travar no meio do movimento
        
        if animateScript then animateScript.Disabled = true end
        for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
            track:AdjustSpeed(0)
        end
    else
        -- MODO: NORMAL (Ícone móvel e animação normal)
        FreezeButton.Image = ID_MOVENDO
        if animateScript then animateScript.Disabled = false end
        for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
            track:AdjustSpeed(1)
        end
    end
end)

print("V6 Finalizada: Arraste bloqueado durante o Freeze. Clique duplo para fechar.")
